# Copy to .env and fill in from your Supabase project settings
# (Project Settings → API). These are PUBLIC keys, safe to ship to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where magic-link emails should redirect back to. In dev this is your LAN URL,
# e.g. http://192.168.1.50:5173. In prod it is your Vercel domain.
VITE_SITE_URL=http://localhost:5173
